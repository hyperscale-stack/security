{
    "alias": "hyperscale-op",
    "description": "hyperscale-stack/security oidc/provider under oauth2.Profile20, headless interaction ({{.Issuer}})",
    "server": {
        "discoveryUrl": "{{.Issuer}}/.well-known/openid-configuration"
    },
    "client": {
        "client_id": "conformance-1",
        "client_secret": "{{.Secret1}}"
    },
    "client_secret_post": {
        "client_id": "conformance-1",
        "client_secret": "{{.Secret1}}"
    },
    "client2": {
        "client_id": "conformance-2",
        "client_secret": "{{.Secret2}}"
    },
    "browser": [
        {
            "comment": "the headless interaction answers at once: the browser lands on the suite's callback",
            "match": "{{.Origin}}/*",
            "tasks": [
                {
                    "task": "Verify Complete",
                    "match": "{{.Callback}}*",
                    "commands": [
                        ["wait", "id", "submission_complete", 10]
                    ]
                }
            ]
        }
    ],
    "override": {
        "oidcc-ensure-registered-redirect-uri": {
            "browser": [
                {
                    "comment": "the provider answers an unregistered redirect_uri with its own error page",
                    "match": "{{.Origin}}/*",
                    "tasks": [
                        {
                            "task": "Expect the redirect URI error page",
                            "match": "{{.Origin}}/*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-request-object-with-redirect-uri": {
            "browser": [
                {
                    "comment": "request objects are not supported: the unregistered redirect_uri parameter gets the error page",
                    "match": "{{.Origin}}/*",
                    "tasks": [
                        {
                            "task": "Expect the redirect URI error page",
                            "match": "{{.Origin}}/*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-prompt-login": {
            "browser": [
                {
                    "comment": "no login page to show (headless interaction): the image is the callback of the second authorization; its auth_time shows the new authentication",
                    "match": "{{.Origin}}/*",
                    "tasks": [
                        {
                            "task": "Verify Complete",
                            "match": "{{.Callback}}*",
                            "commands": [
                                ["wait", "id", "submission_complete", 10],
                                ["wait", "xpath", "//*", 10, ".*", "update-image-placeholder-optional"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-max-age-1": {
            "browser": [
                {
                    "comment": "no login page to show (headless interaction): the image is the callback of the second authorization; its auth_time shows the new authentication",
                    "match": "{{.Origin}}/*",
                    "tasks": [
                        {
                            "task": "Verify Complete",
                            "match": "{{.Callback}}*",
                            "commands": [
                                ["wait", "id", "submission_complete", 10],
                                ["wait", "xpath", "//*", 10, ".*", "update-image-placeholder-optional"]
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
